{
  "name": "huellero-rpa",
  "version": "1.0.0",
  "description": "Robot RPA con Node.js y Playwright para el registro autónomo de inasistencias en Sofia Plus",
  "main": "bot_inasistencias_sofia.js",
  "scripts": {
    "start": "node bot_inasistencias_sofia.js",
    "inasistencias": "node bot_inasistencias_sofia.js",
    "inasistencias:batch": "node bot_inasistencias_sofia.js --batch --auto --confirmar-registro --headless",
    "inasistencias:dry-run": "node bot_inasistencias_sofia.js --batch --auto"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1"
  },
  "author": "SENA ADSO",
  "license": "MIT"
}
