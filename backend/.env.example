# ==============================================================================
# ASISTA - VARIABLES DE ENTORNO DEL SERVIDOR BACKEND (PLANTILLA OFICIAL)
# ==============================================================================

# Puerto HTTP del servidor (por defecto 3000)
PORT=3000

# Zona horaria oficial del SENA / Colombia
TZ=America/Bogota

# Conexión a MongoDB (Atlas o contenedor local)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/huellero?retryWrites=true&w=majority

# Clave secreta para firma de tokens JWT de sesión
JWT_SECRET=sena_jwt_super_secret_key_2026_biometria_adso
JWT_EXPIRES_IN=8h

# Clave Maestra de Cifrado AES-256-GCM para contraseñas de Sofia Plus de Instructores
# NOTA: Si no se define, el backend usa automáticamente el valor de JWT_SECRET.
# Para mantener compatibilidad con las contraseñas ya cifradas en la base de datos,
# usa el mismo valor de JWT_SECRET:
SOFIA_ENCRYPTION_KEY=sena_jwt_super_secret_key_2026_biometria_adso

# Control de Acceso CORS y Orígenes Permitidos
# * = permite cualquier origen (ideal para desarrollo, Coolify y túneles)
# O lista separada por comas: https://asista.tudominio.com,http://localhost:5173
CORS_ORIGIN=*
# Alias soportados: ALLOWED_ORIGINS=* o ORIGENES_PERMITIDOS=*

# Semilla (Seed) Inicial de Cuenta Administrador
# Si la base de datos no tiene una cuenta de administrador registrada, se creará automáticamente con estos valores:
SEED_ADMIN_EMAIL=senahuellero@gmail.com
SEED_ADMIN_PASSWORD=sena2026ADSO
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_TELEFONO=

# Servicio de Correo Electrónico (Notificaciones y confirmación de cambio de clave)
GMAIL_USER=senahuellero@gmail.com
GMAIL_PASS=tu_password_de_aplicacion_gmail

# Umbral de coincidencia biométrica del lector físico
BIOMETRIC_MATCH_THRESHOLD=21474

# Automatización de Inasistencias y Cron de Sofia Plus / RPA
ENABLE_SOFIA_SYNC=true
CRON_SOFIA_SCHEDULE=0 0 * * 6
ENABLE_RPA_ROBOT=true
RPA_DRY_RUN=false
RPA_HEADLESS=true

# Clave compartida para autenticar al Robot RPA (endpoints /api/instructores/*-rpa).
# El robot envía esta clave en la cabecera x-rpa-key; debe coincidir con la
# RPA_API_KEY definida en rpa/.env del robot. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
RPA_API_KEY=
