{
  "name": "huellero",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicación local del huellero DigitalPersona U.are.U 4500 (SENA)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "pngjs": "^7.0.0",
    "socket.io-client": "^4.8.3",
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^30.5.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "co.sena.huellero",
    "productName": "Huellero SENA",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "dll",
        "to": "dll"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh"
    }
  }
}
