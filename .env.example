# ==============================================================================
# ASISTA - Variables de entorno (copiar a .env y completar; NUNCA subir .env a git)
# Usado por docker-compose.yml (raiz) y por el backend (copiar tambien a backend/.env
# si se ejecuta sin Docker).
# ==============================================================================

# --- Obligatorias -------------------------------------------------------------
# Cadena de conexion de MongoDB (Atlas o servidor propio)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/huellero

# Secreto para firmar los JWT. Minimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Clave para cifrar (AES-256-GCM) las contrasenas de Sofia Plus. Generar igual que JWT_SECRET.
# IMPORTANTE: si se cambia, las contrasenas Sofia Plus ya guardadas dejan de poder descifrarse.
SOFIA_ENCRYPTION_KEY=

# --- Opcionales ---------------------------------------------------------------
# Puerto interno de la app (debe coincidir con el "puerto interno" del dominio en Coolify)
PORT=3000
JWT_EXPIRES_IN=8h

# Origenes adicionales permitidos por CORS, separados por coma (la propia app servida
# desde el mismo dominio no lo necesita). Ej: https://asista.midominio.com
CORS_ORIGINS=

# Administrador inicial (solo se usa si no existe ningun admin con ese correo).
# Si ADMIN_PASSWORD se deja vacio se genera una aleatoria y se imprime UNA vez en los logs.
ADMIN_EMAIL=senahuellero@gmail.com
ADMIN_PASSWORD=

# SMTP (Gmail con contrasena de aplicacion) para recuperacion de contrasena
GMAIL_USER=
GMAIL_PASS=

# Cron jobs
ENABLE_SOFIA_SYNC=false
CRON_SCHEDULE=0 0 * * *
CRON_SOFIA_SCHEDULE=0 0 * * 6
