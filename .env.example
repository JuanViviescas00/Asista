# ==============================================================================
# ASISTA - Variables de entorno (copiar a .env y completar; NUNCA subir .env a git)
# Usado por docker-compose.yml (raíz) y por el backend (copiar también a backend/.env
# si se ejecuta sin Docker).
# ==============================================================================

# --- Obligatorias -------------------------------------------------------------
# Cadena de conexión de MongoDB (Atlas o servidor propio)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/huellero

# Secreto para firmar los JWT. Mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Clave para cifrar (AES-256-GCM) las contraseñas de Sofia Plus. Generar igual que JWT_SECRET.
# IMPORTANTE: si se cambia, las contraseñas Sofia Plus ya guardadas dejan de poder descifrarse.
SOFIA_ENCRYPTION_KEY=

# --- Opcionales / Servidor ----------------------------------------------------
# Puerto interno de la app (Render/Coolify asignan el puerto automáticamente o usan 3000)
PORT=3000
TZ=America/Bogota
JWT_EXPIRES_IN=8h

# Control de Acceso CORS y Orígenes Permitidos
# * = permite cualquier origen (ideal para desarrollo y pruebas)
# O lista separada por comas: https://asista.onrender.com,http://localhost:5173
CORS_ORIGIN=*
CORS_ORIGINS=

# Administrador inicial (solo se crea si no existe ningún admin en la base de datos).
# Si ADMIN_PASSWORD se deja vacío se genera una aleatoria y se imprime UNA vez en los logs.
ADMIN_EMAIL=senahuellero@gmail.com
ADMIN_PASSWORD=

# SMTP (Gmail con contraseña de aplicación de 16 caracteres) para recuperación de contraseña
GMAIL_USER=
GMAIL_PASS=

# --- Automatización y Robot RPA (Sofia Plus) ----------------------------------
# Activar o pausar la sincronización automática de inasistencias
ENABLE_SOFIA_SYNC=false
CRON_SCHEDULE=0 0 * * *
CRON_SOFIA_SCHEDULE=0 0 * * 6

# Clave compartida para autenticar al Robot RPA contra el backend (cabecera x-rpa-key).
# Debe coincidir con la RPA_API_KEY definida en el robot. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
RPA_API_KEY=

# Modo de ejecución del Robot RPA (true para pruebas sin guardar en Sofia Plus)
RPA_DRY_RUN=true
RPA_HEADLESS=true

# Umbral de coincidencia biométrica del lector físico (DigitalPersona)
BIOMETRIC_MATCH_THRESHOLD=21474
